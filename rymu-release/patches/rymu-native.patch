+  void _pauseHosting() {
+    final wasHosting = _hosting;
+    _hosting = false;
+    _lastHeartbeat = null;
+    _hostingIssue = null;
+    if (wasHosting) RymuNative.disableHost();
+  }
+
+  void _stopHosting() {
+    if (!_active) return;
+    setState(() {
+      _hostRequested = false;
+      _hostRevision++;
+      _hostRetry = 0;
+      try {
+        try {
+          _pauseHosting();
+        } finally {
+          _account!.setAutoHost(false);
+        }
+      } on ControlError catch (error) {
+        _error = error.code;
+      } on RymuNativeException {
+        _error = 'native_setup_failed';
+      }
+    });
+  }
