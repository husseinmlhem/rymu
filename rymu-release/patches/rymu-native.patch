+#[derive(Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Proof {
+    grant: String,
+    controller_proof: String,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct GrantedHost {
+    id: String,
+    peer_id: String,
+    peer_public_key: String,
+}
+
+#[derive(Deserialize)]
+struct Grant {
+    id: String,
+    grant: String,
+    host: GrantedHost,
+}
