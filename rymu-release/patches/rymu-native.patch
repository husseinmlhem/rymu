+  @override
+  void onWindowClose() {
+    if (_closing) return;
+    unawaited(_hideToTray());
+  }
+
+  Future<void> _hideToTray() async {
+    if (await WindowsTray.hide() || !_active) return;
+    setState(() => _error = 'windows_tray_unavailable');
+    await windowManager.show();
+  }
+
+  Future<void> _quit() async {
+    if (_closing) return;
+    _shutdown();
+    await WindowsTray.remove();
+    await _closeWindow();
+  }
+
+  Future<void> _closeWindow() async {
+    try {
+      await windowManager.setPreventClose(false);
+      await windowManager.close();
+    } catch (_) {
+      await windowManager.destroy();
+    }
+  }
+
+  void _shutdown() {
+    if (_closing) return;
+    _closing = true;
+    _poll?.cancel();
+    _hostRequested = false;
+    _hostRevision++;
+    try {
+      _account?.dispose();
+    } catch (_) {
+      // The process still exits if the native bridge has already shut down.
+    }
+  }
+
+  @override
+  void dispose() {
+    windowManager.removeListener(this);
+    WindowsTray.onQuit(null);
+    unawaited(WindowsTray.remove());
+    _shutdown();
+    _search.dispose();
+    super.dispose();
+  }
