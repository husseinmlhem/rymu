+#[cfg(target_os = "windows")]
+pub(crate) fn windows_locale() -> Option<&'static str> {
+    use winapi::um::winnls::GetUserDefaultUILanguage;
+    match unsafe { GetUserDefaultUILanguage() } & 0x3ff {
+        1 => Some("ar"),
+        9 => Some("en"),
+        _ => None,
+    }
+}
