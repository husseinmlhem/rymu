+
+  Future<void> _editRoute(BuildContext context) async {
+    final a = _account!;
+    final values = [a.apiBase, a.rendezvous, a.relay, a.rendezvousKey];
+    final labels = [
+      t('Control API URL', 'عنوان خدمة الحساب'),
+      t('Rendezvous server', 'خادم التعارف'),
+      t('Relay server', 'خادم التمرير'),
+      t('Server public key', 'المفتاح العام للخادم')
+    ];
+    final result = await showDialog<List<String>>(
+        context: context,
+        builder: (ctx) => Directionality(
+              textDirection: _ar ? TextDirection.rtl : TextDirection.ltr,
+              child: AlertDialog(
+                scrollable: true,
+                title: Text(t('Connection settings', 'إعدادات الاتصال')),
+                content: SizedBox(
+                    width: 430,
+                    child: Column(
+                      mainAxisSize: MainAxisSize.min,
+                      children: [
+                        for (var i = 0; i < values.length; i++)
+                          Padding(
+                              padding: const EdgeInsets.only(bottom: 12),
+                              child: TextFormField(
+                                initialValue: values[i],
+                                onChanged: (value) => values[i] = value,
+                                textDirection: TextDirection.ltr,
+                                decoration:
+                                    InputDecoration(labelText: labels[i]),
+                              )),
+                      ],
+                    )),
+                actions: [
+                  if (a.transport?.isManaged == false)
+                    TextButton(
+                        onPressed: () =>
+                            Navigator.pop(ctx, [a.apiBase, '', '', '']),
+                        child: Text(
+                            t('Use Rymu connection', 'استخدام اتصال ريمو'))),
+                  TextButton(
+                      onPressed: () => Navigator.pop(ctx),
+                      child: Text(t('Cancel', 'إلغاء'))),
+                  FilledButton(
+                      onPressed: () => Navigator.pop(
+                          ctx, values.map((v) => v.trim()).toList()),
+                      child: Text(t('Save', 'حفظ'))),
+                ],
+              ),
+            ));
+    if (result == null || !_active) return;
+    await _run(() async {
+      final previous = a.transport;
+      a.saveSettings(
+          api: result[0],
+          rendezvous: result[1],
+          relay: result[2],
+          key: result[3],
+          ar: _ar);
+      if (previous != a.transport) {
+        _pauseHosting();
+        _hostRetry = 0;
+      }
+      if (a.signedIn) await _refresh();
+    });
+  }
+}
diff --git a/flutter/lib/rymu/windows_logon_start.dart b/flutter/lib/rymu/windows_logon_start.dart
new file mode 100644
index 0000000..53a519e
--- /dev/null
+++ b/flutter/lib/rymu/windows_logon_start.dart
@@ -0,0 +1,151 @@
+import 'dart:ffi';
+import 'dart:io';
+
+import 'package:ffi/ffi.dart';
+import 'package:path/path.dart' as path;
+import 'package:win32/win32.dart';
+
+import 'windows_package_identity.dart';
+
+class WindowsLogonStart {
+  static const _runKey = r'Software\Microsoft\Windows\CurrentVersion\Run';
+  static const _valueName = 'RymuAutoHost';
+  static const _installerKey = r'Software\Rymu\Installer';
+  static const _installerValue = 'StartWithWindows';
+
+  static String? get _command {
+    if (WindowsPackageIdentity.packaged) return null;
+    final localAppData = Platform.environment['LOCALAPPDATA'];
+    if (!Platform.isWindows || localAppData == null) return null;
+    final installed =
+        path.windows.join(localAppData, 'Programs', 'Rymu', 'Rymu.exe');
+    final executable = path.windows.normalize(Platform.resolvedExecutable);
+    if (!path.windows.isAbsolute(executable) ||
+        path.windows.normalize(installed).toLowerCase() !=
+            executable.toLowerCase()) {
+      return null;
+    }
+    final command = '"$executable"';
+    return command.length <= 260 ? command : null;
+  }
+
+  static bool get supported => _command != null;
+
+  static bool? get pendingInstallerPreference {
+    if (!supported) return null;
+    return using((arena) {
+      final key = arena<IntPtr>();
+      final opened = RegOpenKeyEx(
+          HKEY_CURRENT_USER,
+          _installerKey.toNativeUtf16(allocator: arena),
+          0,
+          REG_SAM_FLAGS.KEY_QUERY_VALUE,
+          key);
+      if (opened == WIN32_ERROR.ERROR_FILE_NOT_FOUND) return null;
+      if (opened != WIN32_ERROR.ERROR_SUCCESS) {
+        throw StateError('Opening the installer preference failed ($opened)');
+      }
+      try {
+        final value = arena<Uint32>();
+        final type = arena<Uint32>();
+        final size = arena<Uint32>()..value = sizeOf<Uint32>();
+        final status = RegQueryValueEx(
+            key.value,
+            _installerValue.toNativeUtf16(allocator: arena),
+            nullptr,
+            type,
+            value.cast(),
+            size);
+        if (status == WIN32_ERROR.ERROR_FILE_NOT_FOUND) return null;
+        if (status != WIN32_ERROR.ERROR_SUCCESS ||
+            type.value != REG_VALUE_TYPE.REG_DWORD ||
+            size.value != 4 ||
+            value.value > 1) {
+          throw StateError('Reading the installer preference failed ($status)');
+        }
+        return value.value == 1;
+      } finally {
+        RegCloseKey(key.value);
+      }
+    });
+  }
+
+  static void clearInstallerPreference() {
+    if (!supported) return;
+    using((arena) {
+      final key = arena<IntPtr>();
+      final opened = RegOpenKeyEx(
+          HKEY_CURRENT_USER,
+          _installerKey.toNativeUtf16(allocator: arena),
+          0,
+          REG_SAM_FLAGS.KEY_SET_VALUE,
+          key);
+      if (opened == WIN32_ERROR.ERROR_FILE_NOT_FOUND) return;
+      if (opened != WIN32_ERROR.ERROR_SUCCESS) {
+        throw StateError('Opening the installer preference failed ($opened)');
+      }
+      try {
+        final status = RegDeleteValue(
+            key.value, _installerValue.toNativeUtf16(allocator: arena));
+        if (status != WIN32_ERROR.ERROR_SUCCESS &&
+            status != WIN32_ERROR.ERROR_FILE_NOT_FOUND) {
+          throw StateError(
+              'Clearing the installer preference failed ($status)');
+        }
+      } finally {
+        RegCloseKey(key.value);
+      }
+    });
+  }
+
+  static void setEnabled(bool enabled) {
+    final command = _command;
+    if (command == null) {
+      if (enabled) {
+        throw StateError('Rymu is outside its per-user installation');
+      }
+      return;
+    }
+    using((arena) {
+      final subkey = _runKey.toNativeUtf16(allocator: arena);
+      final name = _valueName.toNativeUtf16(allocator: arena);
+      final key = arena<IntPtr>();
+      final status = enabled
+          ? RegCreateKeyEx(
+              HKEY_CURRENT_USER,
+              subkey,
+              0,
+              nullptr,
+              REG_OPEN_CREATE_OPTIONS.REG_OPTION_NON_VOLATILE,
+              REG_SAM_FLAGS.KEY_SET_VALUE,
+              nullptr,
+              key,
+              nullptr)
+          : RegOpenKeyEx(
+              HKEY_CURRENT_USER, subkey, 0, REG_SAM_FLAGS.KEY_SET_VALUE, key);
+      if (!enabled && status == WIN32_ERROR.ERROR_FILE_NOT_FOUND) return;
+      if (status != WIN32_ERROR.ERROR_SUCCESS) {
+        throw StateError(
+            'Opening the Windows logon registry key failed ($status)');
+      }
+      try {
+        final result = enabled
+            ? RegSetValueEx(
+                key.value,
+                name,
+                0,
+                REG_VALUE_TYPE.REG_SZ,
+                command.toNativeUtf16(allocator: arena).cast(),
+                (command.length + 1) * sizeOf<Uint16>())
+            : RegDeleteValue(key.value, name);
+        if (!enabled && result == WIN32_ERROR.ERROR_FILE_NOT_FOUND) return;
+        if (result != WIN32_ERROR.ERROR_SUCCESS) {
+          throw StateError(
+              'Updating the Windows logon registry value failed ($result)');
+        }
+      } finally {
+        RegCloseKey(key.value);
+      }
+    });
+  }
+}
diff --git a/flutter/lib/rymu/windows_package_identity.dart b/flutter/lib/rymu/windows_package_identity.dart
new file mode 100644
index 0000000..ed88c5a
--- /dev/null
+++ b/flutter/lib/rymu/windows_package_identity.dart
@@ -0,0 +1,22 @@
+import 'dart:ffi';
+import 'dart:io';
+
+import 'package:ffi/ffi.dart';
+import 'package:win32/win32.dart';
+
+/// Package identity is stable for the lifetime of a Windows process.
+class WindowsPackageIdentity {
+  static final bool packaged = _detect();
+
+  static bool _detect() {
+    if (!Platform.isWindows) return false;
+    return using((arena) {
+      final length = arena<Uint32>();
+      final status = GetCurrentPackageFullName(length, nullptr);
+      if (status == 15700) return false; // APPMODEL_ERROR_NO_PACKAGE
+      if (status == WIN32_ERROR.ERROR_INSUFFICIENT_BUFFER) return true;
+      // Fail closed: an unknown identity must never fall back to Run-key writes.
+      throw StateError('Reading Windows package identity failed ($status)');
+    });
+  }
+}
diff --git a/flutter/lib/rymu/windows_packaged_startup.dart b/flutter/lib/rymu/windows_packaged_startup.dart
new file mode 100644
index 0000000..6805964
--- /dev/null
+++ b/flutter/lib/rymu/windows_packaged_startup.dart
@@ -0,0 +1,34 @@
+import 'package:flutter/services.dart';
+
+enum PackagedStartupState {
+  disabled,
+  disabledByUser,
+  enabled,
+  disabledByPolicy,
+  enabledByPolicy;
+
+  bool get enabledForWindows => this == enabled || this == enabledByPolicy;
+
+  bool get managedByPolicy =>
+      this == disabledByPolicy || this == enabledByPolicy;
+}
+
+/// This API is used only after detecting a packaged process. The OS permission
+/// is separate from saved consent to resume hosting after the app opens.
+class WindowsPackagedStartup {
+  static const _channel = MethodChannel('rymu/windows_packaged_startup');
+
+  static Future<PackagedStartupState> query() => _request('query');
+  static Future<PackagedStartupState> setEnabled(bool enabled) =>
+      _request(enabled ? 'enable' : 'disable');
+
+  static Future<PackagedStartupState> _request(String method) async {
+    final value = await _channel
+        .invokeMethod<String>(method)
+        .timeout(const Duration(seconds: 8));
+    return PackagedStartupState.values.firstWhere(
+      (state) => state.name == value,
+      orElse: () => throw StateError('Windows startup state is unavailable'),
+    );
+  }
+}
diff --git a/flutter/lib/rymu/windows_tray.dart b/flutter/lib/rymu/windows_tray.dart
