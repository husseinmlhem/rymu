+                    child: Text(t('Cancel', 'إلغاء'))),
+                FilledButton(
+                    onPressed: () => Navigator.of(dialogContext).pop(
+                        AndroidTransportSettings(values[0].trim(),
+                            values[1].trim(), values[2].trim())),
+                    child: Text(t('Save', 'حفظ'))),
