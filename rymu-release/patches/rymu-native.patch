+    expect(
+        find.textContaining('background icon is unavailable'), findsOneWidget);
+    await tester.tap(find.widgetWithText(TextButton, 'Quit Rymu'));
+    await tester.pump();
+    expect(calls, ['isMinimized', 'show', 'setPreventClose', 'close']);
+    expect(account.disposals, 1);
+    await tester.pumpWidget(const SizedBox.shrink());
+  }, skip: !isolated);
+
+  test('old host defaults on; explicit stop and saved login survive relaunch',
+      () async {
+    RymuNative.writeWindowsVault({
+      'settings': {'api': 'http://127.0.0.1:18787/api/v1'},
+      'session': {
+        'refreshToken': _oldToken,
+        'accessToken': 'saved-access-token',
+        'expiresAt': 2100000000000,
+        'device': {
+          'id': 'isolated-host',
+          'roles': ['host', 'controller'],
+        },
+      },
+    });
+    final oldHost = _StartupFixture();
+    oldHost.ensureAutomaticHosting();
+    expect(oldHost.changes, [true]);
+    oldHost.dispose();
+    final installerOff = _StartupFixture(installerChoice: false);
+    installerOff.ensureAutomaticHosting();
+    installerOff.configureEnrolledHostStartup();
+    expect(installerOff.changes, [false, false]);
+    installerOff.dispose();
+    final stopped = WindowsAccount();
+    stopped.setAutoHost(false);
+    stopped.dispose();
+    final resumed = _StartupFixture();
+    addTearDown(resumed.dispose);
+    resumed.ensureAutomaticHosting();
+    expect(resumed.changes, isEmpty);
+    resumed.configureEnrolledHostStartup();
+    expect(resumed.changes, [false]);
+    expect(resumed.signedIn, isTrue);
+    expect(await resumed.accessToken(), 'saved-access-token');
+    expect(
+        (RymuNative.readWindowsVault()!['settings']
+            as Map)['automaticHostingPreference'],
+        isFalse);
+  }, skip: !isolated);
+
+  testWidgets(
+      'saved host starts without interaction and retries within a budget',
+      (tester) async {
+    final account = _HostingFixture(optedIn: true, failures: 1);
+    await tester.pumpWidget(MaterialApp(
+      home: RymuWindowsHome(createAccount: () => account),
+    ));
+    await tester.pump();
+    expect(account.deviceReads, 1);
+    expect(account.hostStarts, 0);
+    expect(find.text('Start hosting'), findsNothing);
+    expect(find.byType(LinearProgressIndicator), findsNothing);
+    expect(
+        find.text('Waiting for a connection to Rymu. Retrying automatically.'),
+        findsOneWidget);
+
+    var reads = 1;
+    for (final seconds in [2, 4, 8, 16, 20]) {
+      final delay = Duration(seconds: seconds);
+      await tester.pump(delay - const Duration(milliseconds: 1));
+      expect(account.deviceReads, reads);
+      await tester.pump(const Duration(milliseconds: 1));
+      await tester.pump();
+      expect(account.deviceReads, ++reads);
+      expect(account.hostStarts, 1);
+    }
+    await tester.pumpWidget(const SizedBox.shrink());
+    await tester.pump(const Duration(seconds: 30));
+    expect(account.deviceReads, reads);
+  }, skip: !isolated);
+
+  testWidgets('narrow Arabic settings stay usable during account refresh',
+      (tester) async {
+    final account = _HostingFixture(optedIn: false, arabic: true);
+    await tester.binding.setSurfaceSize(const Size(340, 480));
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    await tester.pumpWidget(MaterialApp(
+      builder: (context, child) => MediaQuery(
+        data:
+            MediaQuery.of(context).copyWith(textScaler: TextScaler.linear(1.7)),
+        child: child!,
+      ),
+      home: RymuWindowsHome(createAccount: () => account),
+    ));
+    await tester.pumpAndSettle();
+    expect(account.hostStarts, 0);
+    await tester.tap(find.widgetWithText(TextButton, 'الإعدادات'));
+    await tester.pumpAndSettle();
+    final advanced = find.widgetWithText(OutlinedButton, 'متقدم');
+    await tester.ensureVisible(advanced);
+    await tester.pumpAndSettle();
+    await tester.tap(advanced);
+    await tester.pumpAndSettle();
+    expect(find.byType(AlertDialog), findsOneWidget);
+    expect(find.byType(TextFormField), findsNWidgets(4));
+    expect(tester.takeException(), isNull);
+
+    final held = Completer<void>();
+    account.holdNextRead = held;
+    await tester.pump(const Duration(seconds: 20));
+    await tester.pump();
+    expect(account.deviceReads, 2);
+    await tester.tap(find.widgetWithText(FilledButton, 'حفظ'));
+    await tester.pumpAndSettle();
+    expect(account.settingsSaves, 0);
+    held.complete();
+    await tester.pumpAndSettle();
+    expect(account.settingsSaves, 1);
+    expect(account.hostStarts, 0);
+    expect(tester.takeException(), isNull);
+    await tester.pumpWidget(const SizedBox.shrink());
+  }, skip: !isolated);
+
+  group('Windows refresh token rotation', () {
+    const rotated = {
+      'accessToken': 'fresh-access-token',
+      'refreshToken': _newToken,
+      'expiresAt': 2000000000000,
+      'refreshExpiresAt': 2100000000000,
+    };
+
+    WindowsAccount accountAt(int port) {
+      RymuNative.writeWindowsVault({
+        'settings': {'api': 'http://127.0.0.1:$port/api/v1'},
+        'session': {
+          'refreshToken': _oldToken,
+          'accessToken': 'expired-access-token',
+          'expiresAt': 0,
+          'device': {
+            'id': 'isolated-controller',
+            'roles': ['controller'],
+          },
+        },
+      });
+      final account = WindowsAccount();
+      addTearDown(account.dispose);
+      return account;
+    }
+
+    Future<WindowsAccount> accountWith(
+        List<(int, Map<String, Object?>)> replies,
+        List<(Object?, bool)> requests,
+        {void Function()? onRequest}) async {
+      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+      addTearDown(() => server.close(force: true));
+      server.listen((request) async {
+        final body = jsonDecode(await utf8.decoder.bind(request).join()) as Map;
+        final persisted = RymuNative.readWindowsVault()!['session'] as Map;
+        requests
+            .add((body['refreshToken'], persisted['refreshPending'] == true));
+        onRequest?.call();
+        final (status, payload) = replies[requests.length - 1];
+        request.response
+          ..statusCode = status
+          ..headers.contentType = ContentType.json
+          ..write(jsonEncode(payload));
+        await request.response.close();
+      });
+      return accountAt(server.port);
+    }
+
+    Matcher code(String value) => throwsA(
+        isA<ControlError>().having((error) => error.code, 'code', value));
+
+    test('concurrent callers share a persisted rotation and commit its result',
+        () async {
+      final requests = <(Object?, bool)>[];
+      final visibleState = <(bool, bool)>[];
+      late final WindowsAccount account;
+      account = await accountWith([(200, rotated)], requests, onRequest: () {
+        visibleState.add((account.signedIn, account.needsSignIn));
+      });
+      expect(await Future.wait([account.accessToken(), account.accessToken()]),
+          ['fresh-access-token', 'fresh-access-token']);
+      expect(requests, [(_oldToken, true)]);
+      expect(visibleState, [(true, false)]);
+      final session = RymuNative.readWindowsVault()!['session'] as Map;
+      expect(session['refreshToken'], _newToken);
+      expect(session.containsKey('refreshPending'), isFalse);
+      expect(account.signedIn, isTrue);
+    });
+
+    test('refusal before sending leaves the original token retryable',
+        () async {
+      final listener = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+      final port = listener.port;
+      await listener.close(force: true);
+      final account = accountAt(port);
+      await expectLater(account.accessToken(), code('service_unavailable'));
+      expect(account.signedIn, isTrue);
+      final session = RymuNative.readWindowsVault()!['session'] as Map;
+      expect(session['refreshToken'], _oldToken);
+      expect(session.containsKey('refreshPending'), isFalse);
+    });
+
+    test('ambiguous response requires sign-in after restart and cannot replay',
+        () async {
+      final requests = <(Object?, bool)>[];
+      final account = await accountWith([
+        (500, {'error': 'internal_error'}),
+      ], requests);
+      await expectLater(account.accessToken(), code('refresh_interrupted'));
+      expect(account.signedIn, isFalse);
+      final resumed = WindowsAccount();
+      addTearDown(resumed.dispose);
+      expect(resumed.needsSignIn, isTrue);
+      await expectLater(resumed.accessToken(), code('refresh_interrupted'));
+      expect(requests, [(_oldToken, true)]);
+    });
+
+    test('known unconsumed responses preserve the old token until retry',
+        () async {
+      final requests = <(Object?, bool)>[];
+      final account = await accountWith([
+        (409, {'error': 'account_suspended'}),
+        (429, {'error': 'rate_limited'}),
+        (200, rotated),
+      ], requests);
+      await expectLater(account.accessToken(), code('account_suspended'));
+      expect(account.signedIn, isTrue);
+      await expectLater(account.accessToken(), code('rate_limited'));
+      expect(account.signedIn, isTrue);
+      expect(await account.accessToken(), 'fresh-access-token');
+      expect(requests, List.filled(3, (_oldToken, true)));
+    });
+  }, skip: !isolated);
+}
diff --git a/flutter/tool/build_rymu_android.sh b/flutter/tool/build_rymu_android.sh
new file mode 100644
index 0000000..1d85a34
--- /dev/null
+++ b/flutter/tool/build_rymu_android.sh
@@ -0,0 +1,125 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Pass a dedicated Linux source checkout. This script stages compiled libraries
+# in its jniLibs tree before invoking the upstream Flutter APK builder.
+usage() { echo "Usage: $0 SOURCE APK_OUTPUT_DIR {arm64-v8a|x86_64} {rymu|upstream}" >&2; exit 2; }
+[[ $# == 4 ]] || usage
+source_dir=$(realpath "$1")
+output_dir=$(realpath -m "$2")
+abi=$3
+variant=$4
+build_mode=${RYMU_ANDROID_BUILD_MODE:-debug}
+[[ "$build_mode" == debug || "$build_mode" == release ]] || usage
+if [[ "$build_mode" == release ]]; then
+  : "${RYMU_ANDROID_KEYSTORE:?Public release requires an existing private keystore}"
+  : "${RYMU_ANDROID_STORE_PASSWORD_FILE:?Public release requires a private password file}"
+  test -f "$RYMU_ANDROID_KEYSTORE"
+  test -f "$RYMU_ANDROID_STORE_PASSWORD_FILE"
+  export RYMU_ANDROID_UNSIGNED_RELEASE=1
+fi
+case "$abi" in
+  arm64-v8a) target=aarch64-linux-android; platform=android-arm64; features=flutter,hwcodec ;;
+  x86_64) target=x86_64-linux-android; platform=android-x64; features=flutter ;;
+  *) usage ;;
+esac
+[[ "$variant" == rymu || "$variant" == upstream ]] || usage
+
+: "${FLUTTER_ROOT:?Path to isolated Flutter 3.24.5 SDK (with upstream dropdown patch)}"
+: "${JAVA_HOME:?Path to OpenJDK 17}"
+: "${ANDROID_HOME:?Path to Android SDK with API 36 and build-tools 36.0.0}"
+: "${ANDROID_NDK_HOME:?Path to Android NDK r28c}"
+: "${VCPKG_ROOT:?Path to pinned vcpkg checkout and native build outputs}"
+export ANDROID_NDK_ROOT="$ANDROID_NDK_HOME"
+export CARGO_NET_GIT_FETCH_WITH_CLI=true
+export VCPKG_DISABLE_METRICS=1
+export PATH="$FLUTTER_ROOT/bin:$JAVA_HOME/bin:$PATH"
+# The Android bindgen pass must use the NDK headers, including for hwcodec's
+# C++ bindings. Leave the host's bindgen configuration alone.
+bindgen_key="BINDGEN_EXTRA_CLANG_ARGS_${target//-/_}"
+export "$bindgen_key=--sysroot=$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64/sysroot ${!bindgen_key:-}"
+
+cd "$source_dir"
+expected=23e5bb471a040d62f0a6ad52591fb30784265b73
+if [[ "$variant" == upstream ]]; then
+  [[ $(git rev-parse HEAD) == "$expected" ]] && git diff --quiet HEAD || {
+    echo "Expected clean upstream HEAD $expected" >&2; exit 2;
+  }
+else
+  git merge-base --is-ancestor "$expected" HEAD || {
+    echo "Expected pinned upstream ancestor $expected" >&2; exit 2;
+  }
+fi
+[[ $(git -C libs/hbb_common rev-parse HEAD) == fae47e024dd83cef6aaecde0aa7d11731df11649 ]] || {
+  echo 'Initialize the pinned hbb_common submodule' >&2; exit 2;
+}
+[[ -f src/bridge_generated.rs && -f flutter/lib/generated_bridge.freezed.dart ]] || {
+  echo 'Generate the upstream Flutter/Rust bridge per .github/workflows/bridge.yml first' >&2; exit 2;
+}
+[[ -x "$JAVA_HOME/bin/java" && -f "$ANDROID_HOME/platforms/android-36/android.jar" ]] || {
+  echo 'JDK or Android SDK platform 36 missing' >&2; exit 2;
+}
+grep -Eq '^Pkg.Revision *= *28\.2\.13676358$' "$ANDROID_NDK_HOME/source.properties" || {
+  echo 'Expected NDK r28c (28.2.13676358)' >&2; exit 2;
+}
+[[ $(git -C "$VCPKG_ROOT" rev-parse HEAD) == 9e593bb18ea69cc5095e012465dcd675a822ed0d ]] || {
+  echo 'Unexpected vcpkg revision' >&2; exit 2;
+}
+
+echo "Building $variant $abi with $expected"
+cargo -V
+cargo ndk --version
+flutter --suppress-analytics --version
+"$JAVA_HOME/bin/java" -version
+if [[ -n "${RYMU_ANDROID_DEPS_SOURCE:-}" ]]; then
+  deps_source=$(realpath "$RYMU_ANDROID_DEPS_SOURCE")
+  [[ $(git -C "$deps_source" rev-parse HEAD) == "$expected" ]] || {
+    echo 'Android dependency source has a different upstream revision' >&2; exit 2;
+  }
+  "$deps_source/flutter/build_android_deps.sh" "$abi"
+else
+  ./flutter/build_android_deps.sh "$abi"
+fi
+export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$source_dir/target}"
+# The APK consumes the shared library only. Android has no Rust CLI or service
+# executable; skip those Cargo targets and keep the upstream JNI features.
+cargo ndk --platform 21 --target "$target" build --locked --release --lib --features "$features"
+
+libraries="flutter/android/app/src/main/jniLibs/$abi"
+mkdir -p "$libraries" "$output_dir"
+cp "$CARGO_TARGET_DIR/$target/release/liblibrustdesk.so" "$libraries/librustdesk.so"
+cp "$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/$target/libc++_shared.so" "$libraries/libc++_shared.so"
+
+args=()
+if [[ "$variant" == rymu && "${RYMU_LOCAL_BUILD:-}" == 1 ]]; then
+  args+=(--dart-define=RYMU_LOCAL_BUILD=true)
+fi
+for key in RYMU_API_BASE RYMU_WEB_ORIGIN RYMU_RENDEZVOUS_ENDPOINT RYMU_RELAY_ENDPOINT RYMU_SERVER_PUBLIC_KEY; do
+  if [[ "$variant" == rymu && -n "${!key:-}" ]]; then args+=("--dart-define=$key=${!key}"); fi
+done
+cd flutter
+flutter --suppress-analytics pub get
+if [[ -n "${RYMU_ANDROID_BUILD_NUMBER:-}" ]]; then
+  [[ "$RYMU_ANDROID_BUILD_NUMBER" =~ ^[1-9][0-9]*$ ]]
+  args+=("--build-number=$RYMU_ANDROID_BUILD_NUMBER")
+fi
+flutter --suppress-analytics build apk "--$build_mode" --no-pub --target-platform "$platform" --split-per-abi "${args[@]}"
+candidate="build/app/outputs/flutter-apk/app-$abi-$build_mode.apk"
+test -s "$candidate"
+apk="$output_dir/$variant-$abi-$build_mode${RYMU_ANDROID_BUILD_NUMBER:+-$RYMU_ANDROID_BUILD_NUMBER}.apk"
+test ! -e "$apk" || { echo 'Refusing to overwrite an existing APK' >&2; exit 2; }
+if [[ "$build_mode" == release ]]; then
+  "$ANDROID_HOME/build-tools/36.0.0/zipalign" -c -P 16 4 "$candidate"
+  signed_candidate="$source_dir/rymu-$abi-signed-release.apk"
+  test ! -e "$signed_candidate"
+  "$ANDROID_HOME/build-tools/36.0.0/apksigner" sign \
+    --ks "$RYMU_ANDROID_KEYSTORE" --ks-key-alias rymu-release \
+    --ks-pass "file:$RYMU_ANDROID_STORE_PASSWORD_FILE" \
+    --out "$signed_candidate" "$candidate"
+  candidate="$signed_candidate"
+fi
+"$ANDROID_HOME/build-tools/36.0.0/apksigner" verify --verbose "$candidate"
+unzip -Z1 "$candidate" | grep -Fx "lib/$abi/librustdesk.so"
+unzip -Z1 "$candidate" | grep -Fx "lib/$abi/libc++_shared.so"
+cp "$candidate" "$apk"
+sha256sum "$apk"
diff --git a/flutter/tool/generate_rymu_android_brand.py b/flutter/tool/generate_rymu_android_brand.py
new file mode 100644
index 0000000..0babf4c
--- /dev/null
+++ b/flutter/tool/generate_rymu_android_brand.py
@@ -0,0 +1,92 @@
+"""Build Android drawable layers and Dart mark from the canonical Rymu SVG."""
+
+from pathlib import Path
+import re
+from xml.etree import ElementTree as ET
+from xml.sax.saxutils import quoteattr
+
+
+def save(path: Path, content: str) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(content, encoding="utf-8", newline="\n")
+
+
+flutter = Path(__file__).resolve().parents[1]
+assets = flutter.parents[2] / "design" / "assets"
+resource = flutter / "android" / "app" / "src" / "main" / "res"
+namespace = "{http://www.w3.org/2000/svg}"
+
+mark = (assets / "rymu-mark.svg").read_text(encoding="utf-8").strip()
+save(flutter / "lib" / "rymu_android" / "brand.dart",
+     "// Generated from design/assets/rymu-mark.svg.\n"
+     "const rymuMarkSvg = r'''\n" + mark + "\n''';\n")
+
+foreground = ET.parse(assets / "rymu-android-foreground.svg").getroot()
+background = ET.parse(assets / "rymu-android-background.svg").getroot()
+outer, = foreground.findall(f"{namespace}g")
+inner, = outer.findall(f"{namespace}g")
+translate_scale = re.fullmatch(r"translate\(([\d.]+) ([\d.]+)\) scale\(([\d.]+)\)", outer.attrib["transform"])
+translate = re.fullmatch(r"translate\((-?[\d.]+) (-?[\d.]+)\)", inner.attrib["transform"])
+assert translate_scale and translate, "Unexpected SVG group transform"
+x, y, scale = translate_scale.groups()
+inner_x, inner_y = translate.groups()
+gradients = {gradient.attrib["id"]: gradient for gradient in foreground.iter(f"{namespace}linearGradient")}
+paths = inner.findall(f"{namespace}path")
+background_color = background.find(f"{namespace}path").attrib["fill"]
+
+
+def draw_path(path: ET.Element, gradient_enabled: bool) -> str:
+    source = gradients[path.attrib["fill"][5:-1]]
+    geometry = quoteattr(path.attrib["d"])
+    stops = list(source)
+    if not gradient_enabled:
+        return f'      <path android:pathData={geometry} android:fillColor={quoteattr(stops[1].attrib["stop-color"])} />'
+    coordinates = " ".join(
+        f'android:{dest}={quoteattr(source.attrib[key])}'
+        for key, dest in zip(("x1", "y1", "x2", "y2"), ("startX", "startY", "endX", "endY"))
+    )
+    items = "\n".join(
+        f'            <item android:offset={quoteattr(stop.attrib.get("offset", "0"))} android:color={quoteattr(stop.attrib["stop-color"])} />'
+        for stop in stops
+    )
+    return f'''      <path android:pathData={geometry}>
+        <aapt:attr name="android:fillColor">
+          <gradient android:type="linear" {coordinates}>
+{items}
+          </gradient>
+        </aapt:attr>
+      </path>'''
+
+
+def vector(*, tile: bool, gradient: bool) -> str:
+    outline = (f'  <path android:fillColor="{background_color}" android:pathData="'
+               'M22 0h64q22 0 22 22v64q0 22 -22 22H22Q0 108 0 86V22Q0 0 22 0Z" />\n') if tile else ""
+    paths_xml = "\n".join(draw_path(path, gradient) for path in paths)
+    return f'''<?xml version="1.0" encoding="utf-8"?>
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:aapt="http://schemas.android.com/aapt"
+    android:width="108dp" android:height="108dp"
+    android:viewportWidth="108" android:viewportHeight="108">
+{outline}  <group android:translateX="{x}" android:translateY="{y}" android:scaleX="{scale}" android:scaleY="{scale}">
+    <group android:translateX="{inner_x}" android:translateY="{inner_y}">
+{paths_xml}
+    </group>
+  </group>
+</vector>
+'''
+
+
+save(resource / "drawable-v26" / "rymu_adaptive_foreground.xml", vector(tile=False, gradient=True))
+save(resource / "mipmap-anydpi" / "ic_launcher.xml", vector(tile=True, gradient=False))
+save(resource / "mipmap-anydpi-v24" / "ic_launcher.xml", vector(tile=True, gradient=True))
+save(resource / "mipmap-anydpi-v26" / "ic_launcher.xml", '''<?xml version="1.0" encoding="utf-8"?>
+<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
+  <background android:drawable="@color/rymu_launcher_background" />
+  <foreground android:drawable="@drawable/rymu_adaptive_foreground" />
+</adaptive-icon>
+''')
+save(resource / "values" / "rymu_colors.xml", f'''<?xml version="1.0" encoding="utf-8"?>
+<resources>
+  <color name="rymu_launcher_background">{background_color}</color>
+</resources>
+''')
diff --git a/flutter/tool/stage_rymu_android.sh b/flutter/tool/stage_rymu_android.sh
new file mode 100644
index 0000000..271f19d
--- /dev/null
+++ b/flutter/tool/stage_rymu_android.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+[[ $# == 3 ]] || { echo "Usage: $0 LIVE_FORK BRIDGE_FILES FRESH_LINUX_DESTINATION" >&2; exit 2; }
+fork=$(realpath "$1")
+bridge=$(realpath "$2")
+stage=$(realpath -m "$3")
+[[ ! -e "$stage" ]] || { echo "Android stage already exists: $stage" >&2; exit 2; }
+case "$stage" in /mnt/*) echo 'Android stage must be in the Linux filesystem' >&2; exit 2 ;; esac
+
+head=23e5bb471a040d62f0a6ad52591fb30784265b73
+git -C "$fork" merge-base --is-ancestor "$head" HEAD || { echo "Unexpected client source revision" >&2; exit 2; }
+git -c core.autocrlf=false clone --depth 1 --branch 1.5.1 https://github.com/rustdesk/rustdesk.git "$stage"
+[[ $(git -C "$stage" rev-parse HEAD) == "$head" ]] || { echo "Unexpected tag revision" >&2; exit 2; }
+git -C "$stage" submodule update --init --recursive
+
+# Copy only the product source paths used by this Android build. Ignore IDE
+# settings, caches, build output and all Android signing/local config files.
+list=$(mktemp)
+trap 'rm -f "$list"' EXIT
+paths=(Cargo.toml Cargo.lock src libs res flutter/lib flutter/android flutter/assets flutter/pubspec.yaml flutter/pubspec.lock flutter/test)
+{
+  git -c core.safecrlf=false -C "$fork" diff --name-only -z --no-renames "$head" -- "${paths[@]}"
+  git -C "$fork" ls-files -z --others --exclude-standard -- "${paths[@]}"
+} | sort -zu > "$list"
+while IFS= read -r -d '' file; do
+  case "$file" in
+    */.env*|*/local.properties|*/key.properties|*.jks|*.keystore) continue ;;
+  esac
+  if [[ -f "$fork/$file" && ! -L "$fork/$file" ]]; then
+    install -D -m 0644 "$fork/$file" "$stage/$file"
+  elif [[ ! -e "$fork/$file" && -f "$stage/$file" ]]; then
+    rm -f -- "$stage/$file"
+  fi
+done < "$list"
